# karya bash startup — used ONLY inside karya's tmux panes (via --rcfile).
#
# karya never edits your ~/.bashrc. The pane shell runs `bash --rcfile <this>`,
# which sources your real config UNCHANGED and then layers karya's starship prompt
# on top. Outside karya, your shell is untouched.

# Load the user's real bash config.
[ -f "${HOME}/.bashrc" ] && source "${HOME}/.bashrc"

# karya prompt, initialised last so it wins. STARSHIP_CONFIG is set by `karya
# shell` to karya's own config. A missing starship is a silent no-op.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi
